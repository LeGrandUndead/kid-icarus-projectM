+unsafe fn before_input_read(ctx: *mut Context, address: u32) {
+    use std::sync::{Mutex, OnceLock, atomic::Ordering};
+    let context = unsafe { &*ctx };
+    let (pc, r0, r1) = (context.r[15], context.r[0], context.r[1]);
+    unsafe { machine(ctx).memory.kiu_native_read(address, pc, r0, r1); }
+    let base = crate::services::hid::TRACE_TOUCH_BASE.load(Ordering::Relaxed);
+    if base == 0 || address.wrapping_sub(base) >= crate::services::hid::TRACE_TOUCH_LEN.load(Ordering::Relaxed) { return; }
