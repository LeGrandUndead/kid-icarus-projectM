+fn kiu_hud_atlas(shading: &Shading) -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("KIU_EXPERIMENTAL_HUD").is_some())
