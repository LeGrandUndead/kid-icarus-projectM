+/// important because games (including KIU) do not necessarily use the same
+/// filter for all three operations.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+struct TextureSampling {
+    mag_linear: bool,
+    min_linear: bool,
+    mip_linear: bool,
+    /// Signed fixed1.4.8 value straight from GPUREG_TEXUNITi_LOD.
+    lod_bias_fixed: i16,
+    /// Effective level range after clamping to the mip levels Zakuro loaded.
+    min_level: u8,
+    max_level: u8,
