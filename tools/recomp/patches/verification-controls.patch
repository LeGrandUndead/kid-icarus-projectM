+/// Diagnostic O0 translations can exhaust the Windows main stack before
+/// reaching recomp.h's bounded native call-depth guard. Keep the larger
+/// verification stack explicit; this does not change the game runtime stack.
+#[cfg(feature = "verify")]
+fn check_worker(rom: &str, library: &str, count: usize) {
+    let rom = rom.to_owned();
+    let library = library.to_owned();
+    std::thread::Builder::new()
+        .name("kiu-verification".into())
+        .stack_size(64 * 1024 * 1024)
+        .spawn(move || check(&rom, Path::new(&library), count))
+        .expect("create verification worker")
+        .join()
+        .expect("verification worker panicked");
 }
 
