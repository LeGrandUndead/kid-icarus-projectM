+                }
+            }
+            let existed = path.metadata().is_ok_and(|metadata| metadata.len() != 0);
+            let mut file = match OpenOptions::new().create(true).append(true).open(&path) {
+                Ok(file) => file,
+                Err(error) => {
+                    log::warn!("could not open texture trace {}: {error}", path.display());
+                    return None;
+                }
+            };
+            if !existed {
+                let _ = writeln!(
+                    file,
+                    "unit,address,width,height,format,param,lod,mag_linear,min_linear,mip_linear,lod_bias,requested_min,requested_max,loaded_max,effective_min,effective_max,mip_levels,total_bytes,drawn,legacy_sampling"
+                );
+            }
+            log::info!("texture state trace: {}", path.display());
+            Some(Mutex::new(TextureTrace { file, seen: HashSet::new() }))
+        })
