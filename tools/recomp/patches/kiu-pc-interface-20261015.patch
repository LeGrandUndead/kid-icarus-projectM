+    let mut adjusted = unit.clone();
+    for v in &mut adjusted.float_uniforms[row] { *v *= 15.0 / 16.0; }
+    let scale=crate::kiu_ui::camera::scale();
+    scale_kiu_view(&mut adjusted.float_uniforms,row,scale);
+    Some(adjusted)
