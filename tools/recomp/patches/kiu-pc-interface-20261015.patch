+fn scale_kiu_view(u:&mut [[f32;4];96], horizontal:usize, scale:f32) {
+    if scale==1.0 {return;}
+    for row in [horizontal-1,horizontal] {
+        for component in &mut u[row] {*component*=scale;}
+    }
