+            t.and_then(|t|t.source_hash).unwrap_or(0), t.map_or(0,|t|t.width), t.map_or(0,|t|t.height),
+            t.is_some_and(|t|t.drawn.is_some()), super::kiu_linear_shader_key(s.unit),
