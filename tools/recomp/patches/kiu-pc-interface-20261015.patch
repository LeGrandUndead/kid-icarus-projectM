+    total_bytes: usize,
+    drawn: bool,
+    sampling: TextureSampling,
+) {
+    let Some(trace) = texture_trace() else { return };
+    let key = TextureTraceKey { unit: unit as u8, address, width, height, format, param, lod, drawn };
+    let Ok(mut trace) = trace.lock() else { return };
+    if !trace.seen.insert(key) {
+        return;
+    }
