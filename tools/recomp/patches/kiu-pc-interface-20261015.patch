+            let _ = gpu;
+            rasterize_shaded(&r, &mut memory, &mut resources, vertices);
+            #[cfg(feature = "vulkan")]
+            if let Some(hardware) = &mut resources.hardware { hardware.flush(&mut memory).unwrap(); }
+            pixels(&mut memory)
+        };
+        let expected = render(&reference, false, false);
+        assert!(expected.iter().all(|p| *p == expected[0]));
