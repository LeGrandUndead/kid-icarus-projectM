+//! Opt-in, bounded captures for investigating rendering errors.
+//! Raw registers and encoded texture bytes stay local to the user's project.
+use std::{collections::HashSet, fs::{self, File}, hash::{Hash, Hasher}, io::Write,
+          path::PathBuf, sync::{Mutex, OnceLock}};
+use crate::texture::TextureFormat;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static FRAME: AtomicU64 = AtomicU64::new(0);
+pub fn diagnostic_frame(frame: u64) { FRAME.store(frame, Ordering::Relaxed); }
+pub(crate) fn draw_capture_path() -> Option<&'static PathBuf> {
+    static REQUEST: OnceLock<Option<(u64, PathBuf)>> = OnceLock::new();
+    let (frame, path) = REQUEST.get_or_init(|| {
+        Some((std::env::var("KIU_DRAW_FRAME").ok()?.parse().ok()?,
+              PathBuf::from(std::env::var_os("KIU_DRAW_CAPTURE")?)))
+    }).as_ref()?;
+    (*frame == FRAME.load(Ordering::Relaxed)).then_some(path)
+}
+
+/// Offline isolation only; never enabled by the normal launcher.
+pub(crate) fn ignore_depth_test() -> bool {
+    static IGNORE: OnceLock<bool> = OnceLock::new();
+    *IGNORE.get_or_init(|| std::env::var_os("KIU_DIAGNOSTIC_IGNORE_DEPTH").is_some())
+}
+
+struct Capture {
+    root: PathBuf,
+    draws: File,
+    textures: File,
+    states: HashSet<Vec<u32>>,
+    images: HashSet<(u32, u32, u32, TextureFormat, u64)>,
+    bytes: usize,
+    draw: u64,
+    active: bool,
+}
+
+fn capture() -> Option<&'static Mutex<Capture>> {
+    static CAPTURE: OnceLock<Option<Mutex<Capture>>> = OnceLock::new();
+    CAPTURE.get_or_init(|| {
+        let root = PathBuf::from(std::env::var_os("KIU_RENDER_CAPTURE")?);
+        let open = || -> std::io::Result<Capture> {
+            fs::create_dir_all(&root)?;
+            let mut draws = File::create(root.join("draw-states.csv"))?;
+            writeln!(draws, "id,first_draw,texture_config,proctex_enabled,proctex_config,depth_mask,depth_format")?;
+            let mut textures = File::create(root.join("textures.csv"))?;
+            writeln!(textures, "id,address,width,height,format,encoded_bytes")?;
+            Ok(Capture { root: root.clone(), draws, textures, states: HashSet::new(),
+                         images: HashSet::new(), bytes: 0, draw: 0,
+                         active: std::env::var_os("KIU_RENDER_CAPTURE_WAIT").is_none() })
+        };
+        match open() {
+            Ok(c) => Some(Mutex::new(c)),
+            Err(e) => { log::warn!("render capture unavailable: {e}"); None }
+        }
+    }).as_ref()
+}
+
+/// Start the opt-in capture at the problematic scene, avoiding boot/menu data.
+pub fn start_render_capture() {
+    let Some(c) = capture() else { return };
+    if let Ok(mut c) = c.lock() {
+        c.active = true;
+        log::info!("render capture started: {}", c.root.display());
+    }
+}
+
+pub(crate) fn draw(registers: &[u32]) {
+    let Some(c) = capture() else { return };
+    let Ok(mut c) = c.lock() else { return };
+    if !c.active { return; }
+    c.draw += 1;
+    // Fragment state only: avoid collecting changing vertex-array pointers.
+    let state: Vec<u32> = [0x80, 0xA8, 0xA9, 0xAA, 0xAB, 0xAC, 0xAD,
+        0xC0, 0xC2, 0xC8, 0xCA, 0xD0, 0xD2, 0xD8, 0xDA, 0xF0, 0xF2, 0xF8, 0xFA,
+        0x107, 0x116, 0x85, 0x95, 0x9D].iter().map(|&i| registers[i]).collect();
+    if c.states.len() >= 2048 || !c.states.insert(state.clone()) { return; }
+    let id = c.states.len();
+    let draw = c.draw;
+    let bytes: Vec<u8> = registers[..0x200].iter().flat_map(|v| v.to_le_bytes()).collect();
+    let result = fs::write(c.root.join(format!("draw-{id:04}.bin")), bytes).and_then(|_| {
+        writeln!(c.draws, "{id},{draw},0x{:08X},{},0x{:08X},0x{:08X},0x{:08X}",
+                 registers[0x80], (registers[0x80] >> 10) & 1,
+                 registers[0xA8], registers[0x107], registers[0x116])
+    });
+    if let Err(e) = result { log::warn!("render state capture failed: {e}"); }
+}
+
+pub(crate) fn texture(address: u32, format: TextureFormat, width: u32, height: u32, data: &[u8]) {
+    let Some(c) = capture() else { return };
+    let Ok(mut c) = c.lock() else { return };
+    if !c.active { return; }
+    let bytes = data.len() + width as usize * height as usize * 7 + 64;
+    if c.images.len() >= 256 || c.bytes + bytes > 128 * 1024 * 1024 { return; }
+    let mut hash = std::collections::hash_map::DefaultHasher::new();
+    data.hash(&mut hash);
+    if !c.images.insert((address, width, height, format, hash.finish())) { return; }
+    c.bytes += bytes;
+    let id = c.images.len();
+    let mut ppm = format!("P6\n{width} {height}\n255\n").into_bytes();
+    let mut rgba = Vec::with_capacity(width as usize * height as usize * 4);
+    for y in 0..height {
+        for x in 0..width {
+            let pixel = crate::texture::sample_texel(data, format, width, x, y);
+            ppm.extend_from_slice(&pixel[..3]);
+            rgba.extend_from_slice(&pixel);
+        }
+    }
+    let result = fs::write(c.root.join(format!("texture-{id:04}.bin")), data)
+        .and_then(|_| fs::write(c.root.join(format!("texture-{id:04}.ppm")), ppm))
+        .and_then(|_| fs::write(c.root.join(format!("texture-{id:04}.rgba")), rgba))
+        .and_then(|_| writeln!(c.textures, "{id},0x{address:08X},{width},{height},{format:?},{}", data.len()));
+    if let Err(e) = result { log::warn!("texture capture failed: {e}"); }
+}
+
+/// Bounded projection audit across a replay, including scripted cameras.
+pub(crate) fn projection(unit: &crate::shader::ShaderUnit, width: f32, height: f32) {
+    static AUDIT: OnceLock<Option<Mutex<(File, HashSet<Vec<u32>>)>>> = OnceLock::new();
+    let Some(audit) = AUDIT.get_or_init(|| {
+        let path = std::env::var_os("KIU_PROJECTION_TRACE")?;
+        let mut file = File::create(path).ok()?;
+        writeln!(file, "frame,program,linear_key,width,height,row0,row1,row86,row87,row88,row89").ok()?;
+        Some(Mutex::new((file, HashSet::new())))
+    }) else { return };
+    let Ok(mut audit) = audit.lock() else { return };
+    let id = unit.fingerprint();
+    // Capture code once per identity, including programs used by the CPU
+    // vertex path (the per-draw Vulkan capture cannot see those).
+    static PROGRAMS: OnceLock<Mutex<HashSet<u64>>> = OnceLock::new();
+    if let Ok(mut seen) = PROGRAMS.get_or_init(Default::default).lock() {
+        if seen.len() < 128 && seen.insert(id) {
+            let root = PathBuf::from(std::env::var_os("KIU_PROJECTION_TRACE").unwrap()).with_extension("shaders");
+            let _ = fs::create_dir_all(&root);
+            let bytes: Vec<u8> = unit.program.iter().chain(unit.descriptors.iter()).flat_map(|v| v.to_le_bytes()).collect();
+            let _ = fs::write(root.join(format!("{id:016X}.bin")), bytes);
+            #[cfg(feature = "vulkan")]
+            {
+                let mut shader = unit.clone(); shader.prepare();
+                if let Some(program) = shader.prepared() {
+                    if let Ok(source) = crate::shader::glsl::translate(&program, unit.entry_point, &std::array::from_fn(|i| i as u32)) {
+                        let _ = fs::write(root.join(format!("{id:016X}.vert")), source);
+                    }
+                }
+            }
+        }
+    }
+    let rows = [0,1,86,87,88,89];
+    let mut key = vec![id as u32, (id >> 32) as u32, width.to_bits(), height.to_bits()];
+    for row in rows { key.extend(unit.float_uniforms[row].map(f32::to_bits)); }
+    if audit.1.len() >= 16384 || !audit.1.insert(key) { return; }
+    let _ = write!(audit.0, "{},{id:016X},{:?},{width},{height}", FRAME.load(Ordering::Relaxed), crate::raster::kiu_linear_shader_key(unit));
+    for row in rows { let _ = write!(audit.0, ",\"{:?}\"", unit.float_uniforms[row]); }
+    let _ = writeln!(audit.0);
+}
diff --git a/crates/zakuro-gpu/src/kiu_ui/bake.rs b/crates/zakuro-gpu/src/kiu_ui/bake.rs
new file mode 100644
index 0000000..9bf2d53
--- /dev/null
+++ b/crates/zakuro-gpu/src/kiu_ui/bake.rs
@@ -0,0 +1,79 @@
+//! Applies a draw's own texture combiner to its original texture once, so the
+//! host overlay shows exactly what the game's combiner produced.
+use crate::tev::TexEnv;
+
+/// Combiner output for one texel.
+fn texel(env: &TexEnv, primary: [f32; 4], pixel: [u8; 4]) -> [f32; 4] {
+    let mut textures = [[0.0; 4]; 4];
+    textures[0] = pixel.map(|v| v as f32 / 255.0);
+    env.apply(primary, textures, None)
+}
+
+pub fn premultiply(c: [f32; 4]) -> [u8; 4] {
+    let a = c[3].clamp(0.0, 1.0);
+    [(c[0].clamp(0.0, 1.0) * a * 255.0).round() as u8,
+     (c[1].clamp(0.0, 1.0) * a * 255.0).round() as u8,
+     (c[2].clamp(0.0, 1.0) * a * 255.0).round() as u8, (a * 255.0).round() as u8]
+}
+
+/// Whether the vertex alpha only scales the result's alpha, the usual fade.
+/// Then one baked texture serves every step of a fade, with the alpha given
+/// to the host vertices, instead of a new texture per animation frame.
+/// Checked on a sample of the draw's real texels with its real combiner.
+pub fn alpha_is_a_fade(env: &TexEnv, primary: [f32; 4], texels: &[[u8; 4]]) -> bool {
+    if texels.is_empty() { return false; }
+    let opaque = [primary[0], primary[1], primary[2], 1.0];
+    let half = [primary[0], primary[1], primary[2], 0.5];
+    let step = (texels.len() / 61).max(1);
+    texels.iter().step_by(step).take(64).all(|&pixel| {
+        let (a, b) = (texel(env, opaque, pixel), texel(env, half, pixel));
+        (b[3] - a[3].clamp(0.0, 1.0) * 0.5).abs() < 1.5 / 255.0
+            && (0..3).all(|i| a[3] < 1.0 / 255.0 || (a[i].clamp(0.0, 1.0) - b[i].clamp(0.0, 1.0)).abs() < 1.5 / 255.0)
+    })
+}
+
+/// Premultiplied RGBA8 for the host overlay.
+pub fn bake(env: &TexEnv, primary: [f32; 4], texels: &[[u8; 4]]) -> Vec<u8> {
+    let mut pixels = Vec::with_capacity(texels.len() * 4);
+    for &pixel in texels { pixels.extend(premultiply(texel(env, primary, pixel))); }
+    pixels
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn transparency_is_premultiplied_without_opaque_background() {
+        assert_eq!(premultiply([1.0, 0.5, 0.0, 0.0]), [0, 0, 0, 0]);
+        assert_eq!(premultiply([1.0, 0.5, 0.0, 0.5]), [128, 64, 0, 128]);
+    }
+
+    fn registers(stage0_source: u32, stage0_combine: u32) -> Vec<u32> {
+        // TEV stage 0 at 0xC0: sources, operands, combiners, color, scale
+        let mut r = vec![0u32; 0x300];
+        r[0xC0] = stage0_source;
+        r[0xC1] = 0;
+        r[0xC2] = stage0_combine;
+        r[0xC3] = 0;
+        r[0xC4] = 0;
+        // stages 1-5 pass the previous result through: source previous (0xF)
+        for base in [0xC8, 0xD0, 0xD8, 0xF0, 0xF8] { r[base] = 0x000F_000F; r[base + 2] = 0; }
+        r
+    }
+
+    #[test]
+    fn modulated_fade_is_recognized_and_replace_is_not() {
+        // stage 0: color = texture0 * primary, alpha = texture0 * primary
+        let modulate = registers(0x0003_0003 | (0x0000_0000), 0x0001_0001);
+        // source1 must be primary (0); source0 texture0 (3)
+        let env = TexEnv::read(&modulate);
+        let texels = [[255, 128, 0, 255], [10, 20, 30, 128], [0, 0, 0, 0], [255, 255, 255, 255]];
+        assert!(alpha_is_a_fade(&env, [1.0, 1.0, 1.0, 0.3], &texels));
+        // alpha = primary only would still scale with primary... use a constant instead:
+        // stage 0 replace with texture0: primary alpha has no effect, so a
+        // half-alpha vertex must not be applied as a fade.
+        let replace = registers(0x0003_0003, 0x0000_0000);
+        let env = TexEnv::read(&replace);
+        assert!(!alpha_is_a_fade(&env, [1.0, 1.0, 1.0, 0.3], &texels));
+    }
+}
diff --git a/crates/zakuro-gpu/src/kiu_ui/camera.rs b/crates/zakuro-gpu/src/kiu_ui/camera.rs
new file mode 100644
index 0000000..71c54e0
--- /dev/null
+++ b/crates/zakuro-gpu/src/kiu_ui/camera.rs
@@ -0,0 +1,46 @@
+//! Gameplay lens scale (moved from the October 14 `dialogue` module). Saved
+//! beside the profile's settings, never in the game's save data.
+//!
+//! A scale below 1 widens the projection only: the game still culls, aims
+//! and draws screen effects for its original frustum, so enemies pop in at
+//! the new edges and the reticle/damage effects keep the original frame.
+//! The PC interface therefore starts at 1 (original view) and keeps the
+//! wider view as an option until culling and aim follow it.
+use std::sync::{atomic::{AtomicU32, Ordering}, OnceLock};
+
+/// The PC interface keeps its own value so the October 14 preview keeps its.
+fn pc_interface() -> bool { std::env::var_os("KIU_NATIVE_UI").is_some() }
+
+fn path() -> Option<std::path::PathBuf> {
+    let name = if pc_interface() { "zakuro/pc-interface-camera.txt" } else { "zakuro/gameplay-camera.txt" };
+    std::env::var_os("APPDATA").map(|p| std::path::PathBuf::from(p).join(name))
+}
+
+fn value() -> &'static AtomicU32 {
+    static VALUE: OnceLock<AtomicU32> = OnceLock::new();
+    VALUE.get_or_init(|| {
+        let saved = path().and_then(|p| std::fs::read_to_string(p).ok());
+        let value = std::env::var("KIU_GAMEPLAY_CAMERA_SCALE").ok().or(saved)
+            .and_then(|v| v.trim().parse::<f32>().ok()).filter(|v| v.is_finite())
+            .unwrap_or(if pc_interface() { 1.0 } else { 0.85 }).clamp(0.75, 1.0);
+        AtomicU32::new(value.to_bits())
+    })
+}
+
+pub fn scale() -> f32 {
+    if !super::enabled() { return 1.0; }
+    f32::from_bits(value().load(Ordering::Relaxed))
+}
+
+pub fn set_scale(v: f32) {
+    if super::enabled() && v.is_finite() {
+        let v = v.clamp(0.75, 1.0);
+        value().store(v.to_bits(), Ordering::Relaxed);
+        if let Some(path) = path() {
+            if let Some(parent) = path.parent() { let _ = std::fs::create_dir_all(parent); }
+            if let Err(error) = std::fs::write(path, format!("{v}\n")) {
+                log::warn!("Could not save gameplay camera setting: {error}");
+            }
+        }
+    }
+}
diff --git a/crates/zakuro-gpu/src/kiu_ui/config.rs b/crates/zakuro-gpu/src/kiu_ui/config.rs
new file mode 100644
index 0000000..4141a32
--- /dev/null
+++ b/crates/zakuro-gpu/src/kiu_ui/config.rs
@@ -0,0 +1,82 @@
+//! PC interface options. Host settings in the preview profile
+//! (`roaming/zakuro/kiu-interface.txt`), never the game's save data.
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Interface {
+    /// Original dialogue portraits over gameplay.
+    pub portraits: bool,
+    /// Lower-screen picture inserts (gags, cutaways, title cards).
+    pub inserts: bool,
+    /// Original special gauges / Power Palette / counters over gameplay.
+    pub hud: bool,
+    /// Size of the relocated HUD, 0.5 to 2.
+    pub hud_scale: f32,
+    /// Show the original pause panel automatically when the game pauses.
+    pub auto_pause_panel: bool,
+}
+
+impl Default for Interface {
+    fn default() -> Self { Self { portraits: true, inserts: true, hud: true, hud_scale: 1.0, auto_pause_panel: true } }
+}
+
+impl Interface {
+    pub fn parse(text: &str) -> Self {
+        let mut s = Self::default();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else { continue };
+            let (key, value) = (key.trim(), value.trim());
+            let flag = matches!(value, "1" | "true" | "on");
+            match key {
+                "portraits" => s.portraits = flag,
+                "inserts" => s.inserts = flag,
+                "hud" => s.hud = flag,
+                "hud_scale" => if let Ok(v) = value.parse::<f32>() { if v.is_finite() { s.hud_scale = v.clamp(0.5, 2.0); } },
+                "auto_pause_panel" => s.auto_pause_panel = flag,
+                _ => {}
+            }
+        }
+        s
+    }
+    pub fn text(&self) -> String {
+        format!("portraits={}\ninserts={}\nhud={}\nhud_scale={}\nauto_pause_panel={}\n",
+            self.portraits as u8, self.inserts as u8, self.hud as u8, self.hud_scale, self.auto_pause_panel as u8)
+    }
+}
+
+fn path() -> Option<std::path::PathBuf> {
+    std::env::var_os("APPDATA").map(|p| std::path::PathBuf::from(p).join("zakuro/kiu-interface.txt"))
+}
+
+fn cell() -> &'static Mutex<Interface> {
+    static CELL: OnceLock<Mutex<Interface>> = OnceLock::new();
+    CELL.get_or_init(|| {
+        let mut value = path().and_then(|p| std::fs::read_to_string(p).ok()).map(|t| Interface::parse(&t)).unwrap_or_default();
+        // A launcher switch can disable the relocated HUD for comparison.
+        if std::env::var("KIU_NATIVE_HUD").as_deref() == Ok("0") { value.hud = false; }
+        Mutex::new(value)
+    })
+}
+
+pub fn get() -> Interface { cell().lock().map(|v| *v).unwrap_or_default() }
+
+pub fn set(value: Interface) {
+    if let Ok(mut v) = cell().lock() { *v = value; }
+    if let Some(path) = path() {
+        if let Some(parent) = path.parent() { let _ = std::fs::create_dir_all(parent); }
+        if let Err(error) = std::fs::write(path, value.text()) { log::warn!("Could not save PC interface settings: {error}"); }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn round_trips_and_clamps() {
+        let v = Interface { portraits: false, inserts: false, hud: true, hud_scale: 1.25, auto_pause_panel: false };
+        assert_eq!(Interface::parse(&v.text()), v);
+        assert_eq!(Interface::parse("hud_scale=9\nunknown=1").hud_scale, 2.0);
+        assert_eq!(Interface::parse("hud_scale=NaN"), Interface::default());
+        assert_eq!(Interface::parse(""), Interface::default());
+    }
+}
diff --git a/crates/zakuro-gpu/src/kiu_ui/layout.rs b/crates/zakuro-gpu/src/kiu_ui/layout.rs
new file mode 100644
index 0000000..75ae402
--- /dev/null
+++ b/crates/zakuro-gpu/src/kiu_ui/layout.rs
@@ -0,0 +1,197 @@
+//! Where relocated original bottom-screen layers go in the PC window.
+//!
+//! Pure geometry so it can be tested without the game. Source coordinates are
+//! the guest bottom screen (320x240, origin top left). Window coordinates are
+//! host pixels, origin top left. Nothing here invents UI; it only places the
+//! game's own draws.
+
+/// A rectangle, `[left, top, right, bottom]`.
+pub type Rect = [f32; 4];
+
+/// A group of original bottom-screen draws that is moved as one unit, so the
+/// game's own relative layout and animation inside it are preserved.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Island {
+    pub name: &'static str,
+    /// Region of the guest bottom screen the group lives in.
+    pub source: Rect,
+    pub anchor: Anchor,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Anchor {
+    /// Bottom-left window corner.
+    BottomLeft,
+    /// Right window edge, below the game's own top-screen score.
+    BelowScoreRight,
+}
+
+/// Air special gauges and the land Power Palette share the lower-left corner
+/// of the original screen (October 2026 captures `frame-audit.png`:
+/// orbs at about x 5-95 / y 190-237, palette x 0-125 / y 200-240).
+pub const ACTION: Island = Island { name: "action", source: [0.0, 150.0, 170.0, 240.0], anchor: Anchor::BottomLeft };
+/// Intensity, hearts collected and the heart bank, top right of the original
+/// screen (about x 215-318 / y 2-40 in the same captures).
+pub const COUNTERS: Island = Island { name: "counters", source: [196.0, 0.0, 320.0, 48.0], anchor: Anchor::BelowScoreRight };
+pub const ISLANDS: [Island; 2] = [ACTION, COUNTERS];
+
+/// Draws larger than this are panels/backgrounds, never an island element.
+const MAX_ELEMENT: [f32; 2] = [200.0, 150.0];
+
+/// Axis-aligned bounds of four points.
+pub fn bounds(points: &[[f32; 2]; 4]) -> Rect {
+    let mut r = [f32::INFINITY, f32::INFINITY, f32::NEG_INFINITY, f32::NEG_INFINITY];
+    for p in points {
+        r[0] = r[0].min(p[0]); r[1] = r[1].min(p[1]);
+        r[2] = r[2].max(p[0]); r[3] = r[3].max(p[1]);
+    }
+    r
+}
+
+pub fn center(r: Rect) -> [f32; 2] { [(r[0] + r[2]) * 0.5, (r[1] + r[3]) * 0.5] }
+
+fn inside(p: [f32; 2], r: Rect) -> bool { p[0] >= r[0] && p[0] < r[2] && p[1] >= r[1] && p[1] < r[3] }
+
+/// Which island an element belongs to, by its original screen position.
+/// Background panels and full-screen frames are never island elements.
+pub fn island_for(xy: &[[f32; 2]; 4]) -> Option<Island> {
+    let b = bounds(xy);
+    if !(b[2] - b[0] <= MAX_ELEMENT[0] && b[3] - b[1] <= MAX_ELEMENT[1]) { return None; }
+    let c = center(b);
+    ISLANDS.into_iter().find(|island| inside(c, island.source))
+}
+
+/// The original stylus marker is drawn at the touch point. It is a 3DS
+/// affordance, and the PC reticle already shows aim on the main view.
+pub fn is_touch_marker(xy: &[[f32; 2]; 4], touch: Option<[f32; 2]>) -> bool {
+    let Some(t) = touch else { return false };
+    let b = bounds(xy);
+    let c = center(b);
+    (c[0] - t[0]).abs() <= 3.0 && (c[1] - t[1]).abs() <= 3.0 && b[2] - b[0] <= 64.0 && b[3] - b[1] <= 64.0
+}
+
+/// Host pixels per guest pixel for relocated HUD islands.
+pub fn hud_scale(height: f32, hud: f32) -> f32 { height / 240.0 * 0.5 * hud.clamp(0.5, 2.0) }
+
+/// Host pixels per guest pixel for portraits: a portrait column is about 30%
+/// of the window height (the October 14 preview used 28%).
+pub fn portrait_scale(width: f32, height: f32) -> f32 { (height * 0.30 / 240.0).min(width * 0.22 / 256.0) }
+
+/// The game draws its subtitles in the lower quarter of the main view
+/// (October 14 captures: caption baseline at about 83% of the height).
+/// Portraits stand on this line so they never cover a caption.
+pub const SUBTITLE_TOP: f32 = 0.74;
+
+/// Lower-screen picture inserts (gag art, cutaway comics, boss and rival
+/// title cards) are shown on a surface above the action, top center, the
+/// whole original lower-screen space scaled to this share of the height.
+/// The art covers part of that space; at 0.5 the chapter 1 NES insert is
+/// about a quarter of the view height (0.34 looked too small in play).
+pub const INSERT_HEIGHT: f32 = 0.5;
+pub const INSERT_TOP: f32 = 0.05;
+
+pub fn insert_scale(width: f32, height: f32) -> f32 { (height * INSERT_HEIGHT / 240.0).min(width * 0.6 / 320.0) }
+
+/// Maps a point of an insert layer into the window, keeping the game's own
+/// position and motion inside the original screen.
+pub fn place_insert(p: [f32; 2], width: f32, height: f32) -> [f32; 2] {
+    let s = insert_scale(width, height);
+    [width * 0.5 + (p[0] - 160.0) * s, height * INSERT_TOP + p[1] * s]
+}
+
+pub fn margin(height: f32) -> f32 { height * 0.015 }
+
+/// Top of the counters island: below the game's own score, which occupies
+/// about the top 18% of the main view.
+const BELOW_SCORE: f32 = 0.19;
+
+/// Maps an island element point into the window.
+pub fn place_island(p: [f32; 2], island: Island, width: f32, height: f32, hud: f32) -> [f32; 2] {
+    let s = hud_scale(height, hud);
+    let m = margin(height);
+    let [l, t, r, b] = island.source;
+    match island.anchor {
+        Anchor::BottomLeft => [m + (p[0] - l) * s, height - m - (b - p[1]) * s],
+        Anchor::BelowScoreRight => [width - m - (r - p[0]) * s, height * BELOW_SCORE + (p[1] - t) * s],
+    }
+}
+
+/// Maps a portrait point into the window. Speakers on the left half of the
+/// original screen stay on the left, the others on the right; both stand on
+/// the subtitle line, above the action island (bottom left).
+pub fn place_portrait(p: [f32; 2], right: bool, width: f32, height: f32) -> [f32; 2] {
+    let s = portrait_scale(width, height);
+    let m = margin(height);
+    [if right { width - m - (320.0 - p[0]) * s } else { m + p[0] * s },
+     height * SUBTITLE_TOP - (240.0 - p[1]) * s]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn quad(l: f32, t: f32, r: f32, b: f32) -> [[f32; 2]; 4] { [[l, t], [r, t], [l, b], [r, b]] }
+
+    #[test]
+    fn orbs_and_palette_join_the_action_island() {
+        assert_eq!(island_for(&quad(5.0, 195.0, 47.0, 237.0)), Some(ACTION));
+        assert_eq!(island_for(&quad(45.0, 205.0, 80.0, 238.0)), Some(ACTION));
+        assert_eq!(island_for(&quad(250.0, 4.0, 318.0, 20.0)), Some(COUNTERS));
+    }
+
+    #[test]
+    fn backgrounds_titles_and_frames_are_not_island_elements() {
+        assert_eq!(island_for(&quad(0.0, 0.0, 320.0, 240.0)), None);
+        assert_eq!(island_for(&quad(0.0, 0.0, 200.0, 40.0)), None, "chapter title is centered outside the counters");
+        assert_eq!(island_for(&quad(150.0, 60.0, 320.0, 240.0)), None, "portrait-sized art");
+    }
+
+    #[test]
+    fn touch_marker_is_recognized_only_at_the_touch_point() {
+        let marker = quad(20.0, 200.0, 50.0, 230.0);
+        assert!(is_touch_marker(&marker, Some([35.0, 215.0])));
+        assert!(!is_touch_marker(&marker, Some([100.0, 100.0])));
+        assert!(!is_touch_marker(&marker, None));
+        assert!(!is_touch_marker(&quad(0.0, 0.0, 320.0, 240.0), Some([160.0, 120.0])));
+    }
+
+    #[test]
+    fn islands_stay_on_screen_and_do_not_overlap_at_common_sizes() {
+        for (w, h) in [(1920.0, 1080.0), (1280.0, 720.0), (2560.0, 1440.0), (3840.0, 2160.0), (1024.0, 768.0)] {
+            for hud in [0.5, 1.0, 2.0] {
+                let a = [place_island([0.0, 150.0], ACTION, w, h, hud), place_island([170.0, 240.0], ACTION, w, h, hud)];
+                let c = [place_island([196.0, 0.0], COUNTERS, w, h, hud), place_island([320.0, 48.0], COUNTERS, w, h, hud)];
+                for p in a.iter().chain(&c) { assert!(p[0] >= 0.0 && p[0] <= w && p[1] >= 0.0 && p[1] <= h, "{p:?} {w}x{h} {hud}"); }
+                assert!(a[1][1] <= h && a[0][1] > c[1][1], "action below counters");
+                // the island keeps its aspect
+                let (aw, ah) = (a[1][0] - a[0][0], a[1][1] - a[0][1]);
+                assert!((aw / ah - 170.0 / 90.0).abs() < 0.001);
+            }
+        }
+    }
+
+    #[test]
+    fn portraits_stay_out_of_the_subtitles_and_the_action_island() {
+        for (w, h) in [(1920.0, 1080.0), (1280.0, 720.0), (2560.0, 1440.0), (3840.0, 2160.0)] {
+            for right in [false, true] {
+                let top = place_portrait([0.0, 0.0], right, w, h)[1];
+                let bottom = place_portrait([320.0, 240.0], right, w, h)[1];
+                assert!(bottom <= h * SUBTITLE_TOP + 0.01, "covers subtitles");
+                assert!(top >= h * BELOW_SCORE, "covers health/score");
+                // above the action island up to a 125% HUD (larger sizes may overlap by choice)
+                assert!(bottom <= place_island([0.0, 150.0], ACTION, w, h, 1.25)[1] + 0.01);
+            }
+            assert!((place_portrait([320.0, 240.0], true, w, h)[0] - (w - margin(h))).abs() < 0.01);
+        }
+    }
+
+    #[test]
+    fn inserts_are_centered_above_portraits_and_subtitles() {
+        for (w, h) in [(1920.0, 1080.0), (1280.0, 720.0), (1024.0, 768.0), (3840.0, 2160.0)] {
+            let a = place_insert([0.0, 0.0], w, h);
+            let b = place_insert([320.0, 240.0], w, h);
+            assert!(((a[0] + b[0]) * 0.5 - w * 0.5).abs() < 0.01);
+            assert!(a[0] >= 0.0 && b[0] <= w && a[1] > 0.0 && b[1] < h * SUBTITLE_TOP);
+            assert!(((b[0] - a[0]) / (b[1] - a[1]) - 320.0 / 240.0).abs() < 0.001);
+        }
+    }
+}
diff --git a/crates/zakuro-gpu/src/kiu_ui/mod.rs b/crates/zakuro-gpu/src/kiu_ui/mod.rs
new file mode 100644
index 0000000..8d21b16
--- /dev/null
+++ b/crates/zakuro-gpu/src/kiu_ui/mod.rs
@@ -0,0 +1,388 @@
+//! KIU PC presentation layer: the original bottom-screen UI, recomposed.
+//!
+//! The game keeps rendering both screens. Draws on the bottom screen that
+//! sample a catalogued original ROM texture (identified by the fingerprint of
+//! its encoded bytes) are copied, with their real transforms, UVs and texture
+//! combiner, and redrawn by the host overlay in PC positions:
+//!
+//! - portraits (`FB_*`) beside the gameplay view;
+//! - HUD elements (special gauges, Power Palette, counters) as islands that
+//!   keep the game's own relative layout and animation;
+//! - menu atlases only as evidence of which original panel is up.
+//!
+//! No framebuffer readback, crop, OCR, color guess, invented timer or redrawn
+//! art. Unknown or unmatched draws simply stay in the original bottom screen,
+//! which remains reachable with Tab.
+mod bake;
+pub mod camera;
+pub mod config;
+pub mod layout;
+pub mod scene;
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, OnceLock};
+
+use crate::{Overlay, OverlayMesh, OverlayTexture, OverlayVertex};
+pub use scene::BottomScene;
+
+/// What a catalogued original texture is for.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Role {
+    /// Dialogue portrait art.
+    Portrait,
+    /// Atlas holding gameplay HUD elements.
+    Hud,
+    /// Atlas of the original pause/menu panels.
+    Menu,
+    /// Picture the dialogue refers to: gag art, cutaway comics, retro
+    /// screenshots, boss and rival title cards (`CI_*`, `SP_*`, `BL_/BR_*`).
+    Insert,
+    /// Known but decorative bottom-screen art (backgrounds, chapter titles).
+    Decor,
+    /// Not in the catalog, typically system-font text (power names). Only
+    /// relocated when it lies inside a HUD island, as part of that layout.
+    Unlisted,
+}
+
+impl Role {
+    fn parse(text: &str) -> Option<Role> {
+        Some(match text {
+            "portrait" => Role::Portrait,
+            "hud" => Role::Hud,
+            "menu" => Role::Menu,
+            "decor" => Role::Decor,
+            "insert" => Role::Insert,
+            _ => return None,
+        })
+    }
+}
+
+struct Source { role: Role, name: String }
+
+/// One relocated original draw.
+struct Layer {
+    role: Role,
+    name: usize,
+    texture: u64,
+    xy: [[f32; 2]; 4],
+    uv: [[f32; 2]; 4],
+    /// vertex alpha for fades the combiner applies linearly.
+    alpha: f32,
+    island: Option<layout::Island>,
+}
+
+const MAX_LAYERS: usize = 256;
+const CACHE_LIMIT: usize = 128;
+/// Frames the last complete bottom screen is kept while the game does not
+/// redraw it (some scenes update the lower screen at a lower rate).
+const STALE_FRAMES: u32 = 6;
+
+#[derive(Default)]
+struct State {
+    catalog: HashMap<u64, Source>,
+    names: Vec<String>,
+    cache: HashMap<Vec<u32>, u64>,
+    next: u64,
+    pending: Vec<Layer>,
+    shown: Vec<Layer>,
+    bottom_draws: u32,
+    stale: u32,
+    frame: u64,
+    scene: BottomScene,
+    touch: Option<[f32; 2]>,
+    uploads: Vec<OverlayTexture>,
+    free: Vec<u64>,
+    census: Option<census::Census>,
+}
+
+/// Parses `ui-sources.tsv` (`hash<TAB>role<TAB>name…`) or the October 14
+/// `portrait-hashes.txt` (one hash per line, all portraits).
+fn parse_catalog(text: &str) -> (HashMap<u64, Source>, Vec<String>) {
+    let mut catalog = HashMap::new();
+    let mut names: Vec<String> = Vec::new();
+    for line in text.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') { continue; }
+        let mut fields = line.split('\t');
+        let Some(hash) = fields.next().and_then(|h| u64::from_str_radix(h.trim(), 16).ok()) else { continue };
+        let (role, name) = match fields.next() {
+            Some(role) => match Role::parse(role.trim()) {
+                Some(role) => (role, fields.next().unwrap_or("").trim().to_owned()),
+                None => continue,
+            },
+            None => (Role::Portrait, String::new()),
+        };
+        catalog.insert(hash, Source { role, name });
+    }
+    for source in catalog.values() { if !names.contains(&source.name) { names.push(source.name.clone()); } }
+    (catalog, names)
+}
+
+fn state() -> Option<&'static Mutex<State>> {
+    static STATE: OnceLock<Option<Mutex<State>>> = OnceLock::new();
+    STATE.get_or_init(|| {
+        let file = std::env::var_os("KIU_NATIVE_UI").or_else(|| std::env::var_os("KIU_NATIVE_DIALOGUE"))?;
+        let text = std::fs::read_to_string(&file).ok()?;
+        let (catalog, names) = parse_catalog(&text);
+        if catalog.is_empty() { return None; }
+        let count = |role| catalog.values().filter(|s| s.role == role).count();
+        log::info!("Original PC interface layers: {} portrait, {} insert, {} HUD, {} menu, {} decor textures",
+            count(Role::Portrait), count(Role::Insert), count(Role::Hud), count(Role::Menu), count(Role::Decor));
+        Some(Mutex::new(State { catalog, names, next: 1u64 << 61, census: census::Census::from_environment(), ..State::default() }))
+    }).as_ref()
+}
+
+pub fn enabled() -> bool { state().is_some() }
+
+/// Start of an emulated frame.
+pub fn begin_frame() {
+    let Some(state) = state() else { return };
+    let Ok(mut s) = state.lock() else { return };
+    s.pending.clear();
+    s.bottom_draws = 0;
+    s.frame += 1;
+}
+
+/// End of an emulated frame: a redrawn bottom screen replaces the shown one.
+pub fn end_frame() -> BottomScene {
+    let Some(state) = state() else { return BottomScene::default() };
+    let Ok(mut s) = state.lock() else { return BottomScene::default() };
+    let s = &mut *s;
+    let fresh = s.bottom_draws > 0;
+    if fresh {
+        s.shown = std::mem::take(&mut s.pending);
+        s.stale = 0;
+    } else {
+        s.pending.clear();
+        s.stale += 1;
+        if s.stale > STALE_FRAMES { s.shown.clear(); }
+    }
+    let names = &s.names;
+    s.scene = scene::classify(s.frame, fresh, s.shown.iter().map(|l| scene::Evidence {
+        role: l.role, atlas: &names[l.name], uv: l.uv, island: l.island.is_some(),
+    }));
+    if let Some(census) = &mut s.census { census.record(s.frame, fresh, &s.shown, names); }
+    evict(s);
+    s.scene
+}
+
+/// The last classified bottom screen.
+pub fn scene() -> BottomScene {
+    state().and_then(|s| s.lock().ok().map(|s| s.scene)).unwrap_or_default()
+}
+
+/// The touch point the game was given this frame, guest bottom-screen pixels.
+pub fn set_touch(touch: Option<(u16, u16)>) {
+    if let Some(Ok(mut s)) = state().map(Mutex::lock) { s.touch = touch.map(|(x, y)| [x as f32, y as f32]); }
+}
+
+/// Bounded host texture cache; textures still shown are never freed.
+fn evict(s: &mut State) {
+    if s.cache.len() < CACHE_LIMIT { return; }
+    let live: HashSet<u64> = s.shown.iter().chain(&s.pending).map(|l| l.texture).collect();
+    let mut freed = Vec::new();
+    s.cache.retain(|_, id| if live.contains(id) { true } else { freed.push(*id); false });
+    s.free.extend(freed);
+}
+
+/// Whether a census is being written (diagnostic paths may then do extra work).
+pub(crate) fn census_enabled() -> bool {
+    state().is_some_and(|s| s.lock().is_ok_and(|s| s.census.is_some()))
+}
+
+/// Census only: a lower-screen draw the capture did not take, and why. Each
+/// distinct reason/texture/pipeline combination is written once.
+pub(crate) fn note_rejected(reason: &'static str, detail: String) {
+    if let Some(Ok(mut s)) = state().map(Mutex::lock) {
+        let frame = s.frame;
+        if let Some(census) = &mut s.census { census.rejected(frame, reason, detail); }
+    }
+}
+
+/// A 2D draw reached the guest bottom screen (any texture).
+pub(crate) fn note_bottom_draw() {
+    if let Some(Ok(mut s)) = state().map(Mutex::lock) { s.bottom_draws += 1; }
+}
+
+/// The role of a lower-screen texture: catalogued, or `Unlisted` for any
+/// other ordinary texture.
+pub(crate) fn role(hash: Option<u64>) -> Option<Role> {
+    let hash = hash?;
+    Some(state()?.lock().ok()?.catalog.get(&hash).map_or(Role::Unlisted, |s| s.role))
+}
+
+/// Keeps one original draw. `xy` is in guest bottom-screen pixels.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn push(hash: u64, width: u32, height: u32, texels: &[[u8; 4]],
+    registers: &[u32], primary: [f32; 4], xy: [[f32; 2]; 4], uv: [[f32; 2]; 4]) {
+    let Some(state) = state() else { return };
+    let Ok(mut guard) = state.lock() else { return };
+    let s = &mut *guard;
+    let (role, label) = match s.catalog.get(&hash) {
+        Some(source) => (source.role, source.name.as_str()),
+        None => (Role::Unlisted, "unlisted"),
+    };
+    let name = match s.names.iter().position(|n| n == label) {
+        Some(index) => index,
+        None => { s.names.push(label.to_owned()); s.names.len() - 1 }
+    };
+    if s.pending.len() >= MAX_LAYERS || texels.len() < (width * height) as usize { return; }
+    // Decide placement first: unplaced HUD/menu/decor draws need no texture.
+    let hud_like = matches!(role, Role::Hud | Role::Unlisted);
+    let island = if hud_like && !layout::is_touch_marker(&xy, s.touch) { layout::island_for(&xy) } else { None };
+    // Text and other unlisted art elsewhere (menus, panels) is not kept, nor
+    // procedural effects whose UVs leave the texture (the stylus ripple rings,
+    // UV 0..2 x -1..1 in the October 15 census) — they are not HUD elements.
+    let tiled = uv.iter().flatten().any(|v| !(-0.01..=1.01).contains(v));
+    if role == Role::Unlisted && (island.is_none() || tiled) { return; }
+    let needs_texture = matches!(role, Role::Portrait | Role::Insert) || island.is_some();
+    let texture = if needs_texture {
+        let texels = &texels[..(width * height) as usize];
+        let env = crate::tev::TexEnv::read(registers);
+        let fade = bake::alpha_is_a_fade(&env, primary, texels);
+        let baked_primary = if fade { [primary[0], primary[1], primary[2], 1.0] } else { primary };
+        let mut key = vec![hash as u32, (hash >> 32) as u32, width, height];
+        key.extend(baked_primary.map(f32::to_bits));
+        for base in [0xc0, 0xc8, 0xd0, 0xd8, 0xf0, 0xf8] { key.extend_from_slice(&registers[base..base + 5]); }
+        key.extend([registers[0xe0], registers[0xfd]]);
+        let id = match s.cache.get(&key) {
+            Some(&id) => id,
+            None => {
+                let id = s.next;
+                s.next += 1;
+                s.uploads.push(OverlayTexture { id, offset: None, size: [width, height], pixels: bake::bake(&env, baked_primary, texels), linear: true });
+                s.cache.insert(key, id);
+                id
+            }
+        };
+        if let Some(root) = crate::diagnostics::draw_capture_path() {
+            capture_for_diagnostics(root, s.pending.len(), hash, &env, primary, texels, width, height, xy, uv);
+        }
+        Some((id, if fade { primary[3].clamp(0.0, 1.0) } else { 1.0 }))
+    } else { None };
+    let (texture, alpha) = texture.unwrap_or((0, 1.0));
+    s.pending.push(Layer { role, name, texture, xy, uv, alpha, island });
+}
+
+#[allow(clippy::too_many_arguments)]
+fn capture_for_diagnostics(root: &std::path::Path, index: usize, hash: u64, env: &crate::tev::TexEnv,
+    primary: [f32; 4], texels: &[[u8; 4]], width: u32, height: u32, xy: [[f32; 2]; 4], uv: [[f32; 2]; 4]) {
+    let _ = std::fs::create_dir_all(root);
+    let mut rgba = Vec::with_capacity(texels.len() * 4);
+    for pixel in texels {
+        let mut textures = [[0.0; 4]; 4];
+        textures[0] = pixel.map(|v| v as f32 / 255.0);
+        rgba.extend(env.apply(primary, textures, None).map(|v| (v.clamp(0., 1.) * 255.).round() as u8));
+    }
+    let name = format!("ui-{index}-{hash:016X}");
+    let _ = image::save_buffer(root.join(format!("{name}.png")), &rgba, width, height, image::ColorType::Rgba8);
+    let _ = std::fs::write(root.join(format!("{name}.json")), format!("{{\"xy\":{xy:?},\"uv\":{uv:?},\"primary\":{primary:?}}}"));
+}
+
+/// PICA's V origin is opposite the top-down decoded texture rows, just as
+/// raster.frag converts V before sampling. Host overlay shaders do not.
+fn overlay_uv(uv: [f32; 2]) -> [f32; 2] { [uv[0], 1.0 - uv[1]] }
+
+/// The relocated layers for this window, placed in the window rectangle.
+pub fn overlay(width: u32, height: u32, visible: bool) -> Overlay {
+    overlay_in(width, height, [0.0, 0.0, width as f32, height as f32], visible)
+}
+
+/// The relocated layers placed relative to the game's main view `[x, y, w, h]`
+/// inside the window, so they sit on the picture and not in side bars.
+/// `visible` is the presentation's decision (gameplay view, no panel or menu
+/// over it). Texture uploads and frees are always handed over, so the host
+/// cache stays consistent. Insert before runtime menus so they keep visual
+/// and input precedence.
+pub fn overlay_in(width: u32, height: u32, view: [f32; 4], visible: bool) -> Overlay {
+    let Some(state) = state() else { return Overlay::default() };
+    let Ok(mut s) = state.lock() else { return Overlay::default() };
+    let mut overlay = Overlay { textures: std::mem::take(&mut s.uploads), free: std::mem::take(&mut s.free), ..Overlay::default() };
+    let [vx, vy, w, h] = view;
+    if !visible || width == 0 || height == 0 || !(w >= 1.0 && h >= 1.0) { return overlay; }
+    let interface = config::get();
+    for layer in &s.shown {
+        let place: Box<dyn Fn([f32; 2]) -> [f32; 2]> = match (layer.role, layer.island) {
+            (Role::Portrait, _) if interface.portraits => {
+                let center = layer.xy.iter().map(|v| v[0]).sum::<f32>() / 4.0;
+                let right = center >= 160.0;
+                Box::new(move |p| layout::place_portrait(p, right, w, h))
+            }
+            (Role::Insert, _) if interface.inserts => Box::new(move |p| layout::place_insert(p, w, h)),
+            (Role::Hud | Role::Unlisted, Some(island)) if interface.hud => {
+                let scale = interface.hud_scale;
+                Box::new(move |p| layout::place_island(p, island, w, h, scale))
+            }
+            _ => continue,
+        };
+        let a = (layer.alpha * 255.0).round() as u8;
+        let vertices = (0..4).map(|i| {
+            let [x, y] = place(layer.xy[i]);
+            OverlayVertex { position: [vx + x, vy + y], uv: overlay_uv(layer.uv[i]), color: [a; 4] }
+        }).collect();
+        overlay.meshes.push(OverlayMesh { texture: layer.texture, clip: [0, 0, width, height], vertices, indices: vec![0, 1, 2, 1, 3, 2] });
+    }
+    overlay
+}
+
+/// Optional diagnostic census, `KIU_UI_CENSUS=file.csv`: one row per
+/// catalogued bottom-screen draw whenever the set of draws changes. It is how
+/// the remaining unknown roles (items, vehicle actions, gag art) are traced.
+mod census {
+    use std::io::Write;
+    pub struct Census {
+        file: std::fs::File,
+        last: Vec<String>,
+        rejected: Option<std::fs::File>,
+        seen: std::collections::HashSet<String>,
+    }
+    impl Census {
+        pub fn from_environment() -> Option<Census> {
+            let path = std::path::PathBuf::from(std::env::var_os("KIU_UI_CENSUS")?);
+            let mut file = std::fs::File::create(&path).ok()?;
+            let _ = writeln!(file, "frame,fresh,role,atlas,x0,y0,x1,y1,u0,v0,u1,v1,alpha,island");
+            let mut rejected = std::fs::File::create(path.with_file_name("lower-screen-rejected.csv")).ok();
+            if let Some(f) = &mut rejected { let _ = writeln!(f, "first_frame,reason,detail"); }
+            Some(Census { file, last: Vec::new(), rejected, seen: Default::default() })
+        }
+        pub(super) fn rejected(&mut self, frame: u64, reason: &str, detail: String) {
+            let key = format!("{reason},{detail}");
+            if self.seen.len() < 4096 && self.seen.insert(key.clone()) {
+                if let Some(f) = &mut self.rejected { let _ = writeln!(f, "{frame},{key}"); }
+            }
+        }
+        pub(super) fn record(&mut self, frame: u64, fresh: bool, layers: &[super::Layer], names: &[String]) {
+            let rows: Vec<String> = layers.iter().map(|l| {
+                let b = super::layout::bounds(&l.xy);
+                let mut u = [f32::INFINITY, f32::INFINITY, f32::NEG_INFINITY, f32::NEG_INFINITY];
+                for p in l.uv { u[0] = u[0].min(p[0]); u[1] = u[1].min(p[1]); u[2] = u[2].max(p[0]); u[3] = u[3].max(p[1]); }
+                format!("{:?},{},{:.0},{:.0},{:.0},{:.0},{:.4},{:.4},{:.4},{:.4},{:.2},{}", l.role, names[l.name],
+                    b[0], b[1], b[2], b[3], u[0], u[1], u[2], u[3], l.alpha, l.island.map_or("-", |i| i.name))
+            }).collect();
+            // geometry only; ignore pure alpha animation for the change test
+            let key: Vec<String> = rows.iter().map(|r| r.rsplitn(3, ',').nth(2).unwrap_or(r).to_owned()).collect();
+            if key == self.last { return; }
+            self.last = key;
+            for row in rows { let _ = writeln!(self.file, "{frame},{},{row}", fresh as u8); }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn catalog_accepts_roles_and_the_october_portrait_list() {
+        let (c, names) = parse_catalog("# comment\n00000000000000AB\nCD\thud\tgc_00\nEF\tmenu\tgm_01\n12\tunknown\tx\n");
+        assert_eq!(c[&0xAB].role, Role::Portrait);
+        assert_eq!(c[&0xCD].role, Role::Hud);
+        assert_eq!(c[&0xEF].name, "gm_01");
+        assert!(!c.contains_key(&0x12));
+        assert!(names.contains(&"gc_00".to_owned()));
+    }
+    #[test]
+    fn original_portrait_uv_uses_top_down_host_texture_rows() {
+        assert_eq!(overlay_uv([0., 1.]), [0., 0.]);
+        assert_eq!(overlay_uv([1., 0.]), [1., 1.]);
+    }
+}
diff --git a/crates/zakuro-gpu/src/kiu_ui/scene.rs b/crates/zakuro-gpu/src/kiu_ui/scene.rs
new file mode 100644
index 0000000..33578c2
--- /dev/null
+++ b/crates/zakuro-gpu/src/kiu_ui/scene.rs
@@ -0,0 +1,175 @@
+//! What the original bottom screen is showing, from the identity of the
+//! textures it draws. Evidence is the ROM atlas a draw samples and the part of
+//! the atlas it samples; never pixel colors, framebuffer contents or timers.
+
+use super::Role;
+
+/// Normalized atlas rectangle `[u0, v0, u1, v1]`, rows counted in the
+/// texture's stored order (the order `cgfx_textures.py` decodes).
+type UvRect = [f32; 4];
+
+/// The "Resume" label of the in-game pause menu inside `common/info` atlas
+/// `gm_01` (pixels 3-80 x 214-246 of 256x256, measured from the ROM atlas).
+const RESUME_LABEL: UvRect = [3.0 / 256.0, 214.0 / 256.0, 80.0 / 256.0, 246.0 / 256.0];
+
+/// The "Retreat" label beside it (pixels 80-160 x 214-246).
+const RETREAT_LABEL: UvRect = [80.0 / 256.0, 214.0 / 256.0, 160.0 / 256.0, 246.0 / 256.0];
+
+/// The October 15 census confirmed Resume and Retreat at UV
+/// 0-0.3125 / 0.3125-0.625 x 0.0273-0.168 (PICA V) sliding in from the sides.
+/// `gm_01` also holds the ornate corners of the ordinary gameplay frame, so
+/// only these labels, never the atlas alone, count as the pause menu.
+const PAUSE_LABELS: [UvRect; 3] = [RESUME_LABEL, RETREAT_LABEL, REMOVE_DISPLAY_LABEL];
+
+/// End cap of the option bars (pixels 238-253 x 0-30): drawn on the pause
+/// menu's Options bar and on every bar of the Options sub-screen (October 15
+/// census, frames 11339+), never in ordinary gameplay. While it is drawn the
+/// player is in a menu even though no pause label is.
+const OPTION_BAR_CAP: UvRect = [0.9297, 0.0, 0.9883, 0.1172];
+
+/// The "Remove Display" label of the same pause menu (pixels 0-96 x 146-178).
+/// The October 15 census shows it is the first pause art drawn, sliding in
+/// from the bottom edge, sampled at UV 0-0.375 x 0.3047-0.4297 (PICA V).
+const REMOVE_DISPLAY_LABEL: UvRect = [0.0, 146.0 / 256.0, 96.0 / 256.0, 178.0 / 256.0];
+
+/// One bottom-screen frame, summarized.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct BottomScene {
+    /// Emulated frame the summary belongs to.
+    pub frame: u64,
+    /// The game drew its bottom screen this frame (otherwise the previous
+    /// complete summary is repeated).
+    pub fresh: bool,
+    /// Original portrait layers, any speaker.
+    pub portraits: u8,
+    /// Picture inserts the dialogue refers to.
+    pub inserts: u8,
+    /// Original HUD elements that were relocated into the PC HUD.
+    pub hud: u16,
+    /// The original pause menu's Resume label is on the bottom screen.
+    pub pause_menu: bool,
+    /// A pause-menu label or an option bar is drawn: the player is in the
+    /// pause menu or one of its sub-screens (Options).
+    pub menu: bool,
+}
+
+/// A layer, as far as classification is concerned.
+pub struct Evidence<'a> {
+    pub role: Role,
+    pub atlas: &'a str,
+    pub uv: [[f32; 2]; 4],
+    pub island: bool,
+}
+
+fn uv_bounds(uv: &[[f32; 2]; 4]) -> UvRect {
+    let mut r = [f32::INFINITY, f32::INFINITY, f32::NEG_INFINITY, f32::NEG_INFINITY];
+    for p in uv {
+        r[0] = r[0].min(p[0]); r[1] = r[1].min(p[1]);
+        r[2] = r[2].max(p[0]); r[3] = r[3].max(p[1]);
+    }
+    r
+}
+
+/// The sampled rectangle is the label, in either V convention: PICA counts V
+/// from the opposite end of the stored rows, and some layout tools flip it.
+fn samples_label(uv: &[[f32; 2]; 4], label: UvRect) -> bool {
+    let b = uv_bounds(uv);
+    let (w, h) = (b[2] - b[0], b[3] - b[1]);
+    let (lw, lh) = (label[2] - label[0], label[3] - label[1]);
+    // the whole word, not one glyph or a stretched strip
+    if !(w > lw * 0.6 && w < lw * 1.6 && h > lh * 0.5 && h < lh * 1.8) { return false; }
+    let c = [(b[0] + b[2]) * 0.5, (b[1] + b[3]) * 0.5];
+    let within = |v: f32, lo: f32, hi: f32| v >= lo - 0.02 && v <= hi + 0.02;
+    within(c[0], label[0], label[2])
+        && (within(c[1], label[1], label[3]) || within(1.0 - c[1], label[1], label[3]))
+}
+
+pub fn classify<'a>(frame: u64, fresh: bool, layers: impl Iterator<Item = Evidence<'a>>) -> BottomScene {
+    let mut scene = BottomScene { frame, fresh, ..BottomScene::default() };
+    for layer in layers {
+        match layer.role {
+            Role::Portrait => scene.portraits = scene.portraits.saturating_add(1),
+            Role::Menu if layer.atlas == "gm_01" => {
+                if PAUSE_LABELS.iter().any(|label| samples_label(&layer.uv, *label)) {
+                    scene.pause_menu = true;
+                    scene.menu = true;
+                } else if samples_label(&layer.uv, OPTION_BAR_CAP) {
+                    scene.menu = true;
+                }
+            }
+            Role::Menu => {}
+            Role::Insert => scene.inserts = scene.inserts.saturating_add(1),
+            Role::Hud | Role::Decor | Role::Unlisted => {}
+        }
+        if layer.island { scene.hud = scene.hud.saturating_add(1); }
+    }
+    scene
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn uv(l: f32, t: f32, r: f32, b: f32) -> [[f32; 2]; 4] { [[l, t], [r, t], [l, b], [r, b]] }
+    fn ev(role: Role, atlas: &str, uv: [[f32; 2]; 4]) -> Evidence<'_> { Evidence { role, atlas, uv, island: false } }
+
+    #[test]
+    fn resume_label_identifies_the_pause_menu_in_both_v_conventions() {
+        let stored = uv(3.0 / 256.0, 214.0 / 256.0, 80.0 / 256.0, 246.0 / 256.0);
+        let flipped = uv(3.0 / 256.0, 1.0 - 246.0 / 256.0, 80.0 / 256.0, 1.0 - 214.0 / 256.0);
+        for label in [stored, flipped] {
+            let s = classify(7, true, [ev(Role::Menu, "gm_01", label)].into_iter());
+            assert!(s.pause_menu && s.menu && s.frame == 7);
+        }
+    }
+
+    #[test]
+    fn census_pause_draws_identify_the_pause_menu() {
+        // exact rectangles recorded on October 15 (frame 13533+)
+        let remove_display = uv(0.0, 0.3047, 0.3750, 0.4297);
+        let separator = uv(0.9941, 0.9141, 0.9941, 1.0);
+        let icon = uv(0.75, 0.3984, 0.8281, 0.4766);
+        let s = classify(1, true, [ev(Role::Menu, "gm_01", separator), ev(Role::Menu, "gm_01", icon)].into_iter());
+        assert!(!s.menu && !s.pause_menu);
+        for label in [remove_display, uv(0.0, 0.0273, 0.3125, 0.1680), uv(0.3125, 0.0273, 0.6250, 0.1680)] {
+            let s = classify(1, true, [ev(Role::Menu, "gm_01", label)].into_iter());
+            assert!(s.pause_menu && s.menu);
+        }
+    }
+
+    #[test]
+    fn options_sub_screen_bars_keep_the_menu_without_a_pause_label() {
+        // October 15 census, frame 11343: Options sub-screen, no Resume/Retreat
+        let cap = uv(0.9297, 0.8828, 0.9883, 1.0);
+        let bar = uv(0.9844, 0.8828, 0.9844, 1.0);
+        let s = classify(1, true, [ev(Role::Menu, "gm_01", bar), ev(Role::Menu, "gm_01", cap)].into_iter());
+        assert!(s.menu && !s.pause_menu);
+    }
+
+    #[test]
+    fn gameplay_frame_corners_from_the_menu_atlas_are_not_a_menu() {
+        // October 15 census, frame 5022: ordinary chapter frame pieces in gm_01
+        let corners = [uv(0.4609, 0.7578, 0.7031, 1.0), uv(0.0, 0.5391, 0.4609, 1.0),
+            uv(0.7012, 0.9688, 0.7012, 1.0), uv(0.4609, 0.7598, 0.4922, 0.7598), uv(0.4590, 0.5391, 0.4590, 0.5703)];
+        let s = classify(1, true, corners.into_iter().map(|c| ev(Role::Menu, "gm_01", c)));
+        assert!(!s.menu && !s.pause_menu);
+    }
+
+    #[test]
+    fn other_menu_art_or_other_atlases_are_not_the_pause_menu() {
+        // "Retreat" beside it, a single glyph, and the same rectangle in another atlas
+        let middle_retreat = uv(0.45, 0.30, 0.75, 0.40);
+        let glyph = uv(3.0 / 256.0, 214.0 / 256.0, 15.0 / 256.0, 246.0 / 256.0);
+        let label = uv(3.0 / 256.0, 214.0 / 256.0, 80.0 / 256.0, 246.0 / 256.0);
+        let s = classify(1, true, [ev(Role::Menu, "gm_01", middle_retreat), ev(Role::Menu, "gm_01", glyph),
+            ev(Role::Hud, "gc_00", label)].into_iter());
+        assert!(!s.pause_menu && !s.menu);
+    }
+
+    #[test]
+    fn counts_portraits_and_relocated_hud() {
+        let mut hud = ev(Role::Hud, "gc_00", uv(0.0, 0.0, 0.1, 0.1));
+        hud.island = true;
+        let s = classify(3, true, [ev(Role::Portrait, "FB_000", uv(0.0, 0.0, 1.0, 1.0)), hud].into_iter());
+        assert_eq!((s.portraits, s.hud, s.menu, s.pause_menu), (1, 1, false, false));
+    }
+}
