+/// Experimental KIU USA 16:9 projection. Only shader/matrix pairs observed
+/// in the recorded title are eligible; scene-copy and bottom-screen draws stay
+/// unchanged. GPU and CPU shading consume the same adjusted uniform data.
+fn kiu_wide_shader(registers: &[u32], unit: &ShaderUnit) -> Option<ShaderUnit> {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var_os("KIU_EXPERIMENTAL_WIDE").is_some()) { return None; }
+    let width = read_float24(registers, REG_VIEWPORT_WIDTH) * 2.0;
+    let height = read_float24(registers, REG_VIEWPORT_HEIGHT) * 2.0;
+    crate::diagnostics::projection(unit, width, height);
+    if (width - 240.0).abs() > 0.01 || (height - 400.0).abs() > 0.01 { return None; }
+    let fingerprint = unit.fingerprint();
+    // This exact HUD program occurs under different full-memory fingerprints
+    // after menus, cutscenes and land transitions. Only executed instructions
+    // and the descriptors they actually use define its identity.
+    let identity = if matches!(fingerprint, 0x5132E71D8B2FE0FB | 0xFD02797C12EA5C7C | 0x67A1295922939A3A | 0x798D4FC813C0B966) { fingerprint }
+        else if kiu_linear_shader_key(unit) == Some(18295097681142006406) {
+            0x19037D7C6A2EE397
+        } else { return None; };
+    let row = kiu_projection_row(identity, &unit.float_uniforms)?;
+    let mut adjusted = unit.clone();
+    for v in &mut adjusted.float_uniforms[row] { *v *= 15.0 / 16.0; }
+    Some(adjusted)
+}
+
+/// Identify a straight-line shader by executed words and referenced operands,
+/// excluding leftover instructions/descriptors from previous shader uploads.
+pub(crate) fn kiu_linear_shader_key(unit: &ShaderUnit) -> Option<u64> {
+    use crate::shader::isa::{Instruction, OpCode};
+    let mut hash = 0xcbf29ce484222325u64;
+    let mut mix = |word: u32| {
+        for byte in word.to_le_bytes() {
+            hash = (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3);
+        }
+    };
+    let start = usize::try_from(unit.entry_point).ok()?;
+    for &word in unit.program.get(start..)?.iter().take(128) {
+        let instruction = Instruction(word);
+        let op = instruction.opcode();
+        mix(word);
+        if op == OpCode::End { return Some(hash); }
+        if op == OpCode::Nop { continue; }
+        if !op.writes() { return None; }
+        let index = if matches!(op, OpCode::Mad | OpCode::MadI) {
+            instruction.mad_descriptor_index()
+        } else { instruction.descriptor_index() };
+        mix(*unit.descriptors.get(index as usize)?);
+    }
+    None
+}
+
+/// Only the observed independent four-vertex HUD rectangles are eligible.
+pub(crate) fn kiu_quad_indices(indices: &[u32]) -> bool {
+    !indices.is_empty() && indices.len() % 6 == 0 && indices.chunks_exact(6)
+        .enumerate().all(|(i, tri)| {
+            let v = i as u32 * 4;
+            tri == [v, v+1, v+2, v+1, v+3, v+2]
+        })
+}
+
+pub(crate) fn kiu_hud_anchor_bounds(bounds: [f32; 4]) -> f32 {
+    let matches = |expected: [f32; 4]| bounds.iter().zip(expected).all(|(v, e)| (*v-e).abs() < 0.01);
+    if matches([0.0, 5.0, 172.0, 39.0])
+        || matches([14.0, 0.0, 143.0, 41.0])
+        || matches([0.0, 8.0, 31.0, 39.0])
+        // The health fill shortens as health changes; the bar's origin and
+        // vertical bounds stay fixed. Shift the fill and its frame together.
+        || ((bounds[0]-32.0).abs() < 0.01 && (bounds[1]-18.0).abs() < 0.01
+            && (bounds[3]-23.0).abs() < 0.01 && (32.0..=122.01).contains(&bounds[2])) { 0.0625 }
+    else if matches([312.0, 0.0, 400.0, 48.0]) || matches([382.0, 0.0, 400.0, 13.0]) { -0.0625 }
+    else { 0.0 }
+}
+
+fn kiu_projection_row(fingerprint: u64, u: &[[f32; 4]; 96]) -> Option<usize> {
+    let close = |a: f32, b: f32| a.is_finite() && (a-b).abs() < 0.0001;
+    match fingerprint {
+        // Rotated perspective projection: vertical scale in row 86, horizontal
+        // in 87. Preserve vertical FOV; expose 16/15 as much world horizontally.
+        0x5132E71D8B2FE0FB | 0xFD02797C12EA5C7C
+            if kiu_perspective(&u[86..90]) => Some(87),
+        // Recorded alternate effect programs project through rows 0..3.
+        // Their translated code is identical across these two memory hashes.
+        0x67A1295922939A3A | 0x798D4FC813C0B966
+            if kiu_perspective(&u[0..4]) => Some(1),
+        // Orthographic HUD, centered in the original safe area with unchanged
+        // physical proportions after the top image is presented at 16:9.
+        0x19037D7C6A2EE397 if close(u[0][1], -2.0/240.0)
+            && close(u[1][0], -2.0/400.0)
+            && u[1][1..] == [0.0, 0.0, 1.0]
+            && u[3] == [0.0, 0.0, 0.0, 1.0] => Some(1),
+        _ => None,
+    }
+}
+
+fn kiu_perspective(rows: &[[f32; 4]]) -> bool {
+    rows.len() == 4 && rows.iter().flatten().all(|v| v.is_finite())
+        && rows[3] == [0.0, 0.0, -1.0, 0.0]
+        && rows[0][1] > 0.0 && rows[1][0] < 0.0
+        // The title temporarily uploads 1.6656 during camera transitions.
+        // Accept that quantization, but reject 4:3, 16:9 and arbitrary lenses.
+        && (rows[0][1] / -rows[1][0] - 5.0/3.0).abs() < 0.002
+}
