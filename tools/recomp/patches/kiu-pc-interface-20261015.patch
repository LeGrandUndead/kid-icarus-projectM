+
+impl TextureSampling {
+    fn lod_bias(self) -> f32 {
+        self.lod_bias_fixed as f32 / 256.0
+    }
+}
+
+/// Sign-extends the PICA's 13-bit fixed1.4.8 LOD bias.
+fn lod_bias_fixed(raw: u32) -> i16 {
+    let value = (raw & 0x1FFF) as i32;
+    ((value << 19) >> 19) as i16
+}
+
+/// The PICA's ordinary 2D textures are tiled in 8x8 blocks. citro3d likewise
+/// accepts texture dimensions no smaller than 8, so do not walk a mip chain
+/// past the last complete 8x8 level our decoder can represent.
+fn max_tiled_mip_level(width: u32, height: u32) -> u8 {
+    if width < 8 || height < 8 || width % 8 != 0 || height % 8 != 0 {
+        return 0;
+    }
+    let mut level = 0u8;
+    while level < 15 {
+        let next = level + 1;
+        let w = width >> next;
+        let h = height >> next;
+        if w < 8 || h < 8 || w % 8 != 0 || h % 8 != 0 {
+            break;
+        }
+        level = next;
+    }
+    level
+}
+
+fn mip_dimensions(width: u32, height: u32, level: u8) -> (u32, u32) {
+    ((width >> level).max(1), (height >> level).max(1))
+}
+
+fn texture_level_size(format: TextureFormat, width: u32, height: u32) -> usize {
+    let bits = width as u64 * height as u64 * format.bits_per_pixel() as u64;
+    bits.div_ceil(8) as usize
+}
+
+fn texture_chain_size(format: TextureFormat, width: u32, height: u32, max_level: u8) -> usize {
+    (0..=max_level)
+        .map(|level| {
+            let (w, h) = mip_dimensions(width, height, level);
+            texture_level_size(format, w, h)
+        })
+        .sum()
+}
+
+fn texture_chain_texels(width: u32, height: u32, max_level: u8) -> usize {
+    (0..=max_level)
+        .map(|level| {
+            let (w, h) = mip_dimensions(width, height, level);
+            (w * h) as usize
+        })
+        .sum()
+}
