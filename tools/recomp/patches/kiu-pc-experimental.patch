+// Catmull-Rom reconstruction at magnification only. Nine bilinear taps
+// preserve original texel-center values and artwork; no asset is redrawn.
+vec4 original_art_sample(sampler2D tex, vec2 st, uint unit) {
+    if (units[unit].w == 0u) return texture(tex, st);
+    vec2 size = vec2(textureSize(tex, 0));
+    float footprint = max(length(dFdx(st) * size), length(dFdy(st) * size));
+    if (footprint >= 1.0) return texture(tex, st);
+    vec2 pixel = st * size - 0.5;
+    vec2 base = floor(pixel);
+    vec2 f = pixel - base;
+    vec2 w0 = -0.5*f + f*f - 0.5*f*f*f;
+    vec2 w1 = 1.0 - 2.5*f*f + 1.5*f*f*f;
+    vec2 w2 = 0.5*f + 2.0*f*f - 1.5*f*f*f;
+    vec2 w3 = -0.5*f*f + 0.5*f*f*f;
+    vec2 w12 = w1 + w2;
+    vec2 locations[3] = vec2[3]((base - 0.5)/size,
+        (base + 0.5 + w2/w12)/size, (base + 2.5)/size);
+    vec2 weights[3] = vec2[3](w0, w12, w3);
+    vec2 low = vec2(-1e10), high = vec2(1e10);
+    if (unit == 0u && units[0].z != 0u) {
+        vec2 a = vec2(in_quaternion.x, 1.0-in_quaternion.w);
+        vec2 b = vec2(in_quaternion.z, 1.0-in_quaternion.y);
+        vec2 middle = (a+b)*0.5;
+        low = min(a + 0.5/size, middle);
+        high = max(b - 0.5/size, middle);
+    }
+    vec4 color = vec4(0.0);
+    for (int y=0; y<3; ++y) for (int x=0; x<3; ++x) {
+        vec2 uv = clamp(vec2(locations[x].x, locations[y].y), low, high);
+        color += textureLod(tex, uv, 0.0) * weights[x].x * weights[y].y;
+    }
+    // Blend near minification to avoid a visible LOD boundary.
+    return mix(clamp(color, 0.0, 1.0), texture(tex, st), smoothstep(0.75,1.0,footprint));
+}
