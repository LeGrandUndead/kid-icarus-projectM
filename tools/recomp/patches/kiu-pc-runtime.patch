+    /// Readback makes memory current; it does not invalidate the scaled image.
+    /// Reuse a clean image only while the requested bytes still match its shadow
+    /// and no newer overlapping GPU writes exist.
+    pub(crate) fn holds_for_read<M: GpuMemory>(&self, texture: &DrawnTexture, memory: &mut M) -> bool {
+        if self.holds(texture) { return true; }
+        let Some((index, row)) = self.texture_source(texture) else { return false };
+        let surface = &self.surfaces[index];
+        if surface.dirty.is_some() { return false; }
+        let len = texture.height * surface.row_bytes();
+        if self.surfaces.iter().enumerate().any(|(i, s)| i != index && s.dirty_overlaps(texture.addr, len)) {
+            return false;
+        }
+        let start = (row * surface.row_bytes()) as usize;
+        let Some(shadow) = surface.shadow.get(start..start + len as usize) else { return false };
+        if let Some(bytes) = memory.slice(texture.addr, len as usize) {
+            return bytes == shadow;
+        }
+        let mut bytes = vec![0; len as usize];
+        memory.read(texture.addr, &mut bytes);
+        bytes == shadow
+    }
