+
+// Keep the opt-in camera watches and explicit diagnostic watches armed across
+// intermediate copies. Both are inactive during ordinary controller-only play.
+unsafe fn after_input_read(ctx: *mut Context, address: u32) {
+    use std::sync::atomic::Ordering;
+    unsafe { machine(ctx).memory.rearm_kiu_mouse(address); }
+    let base = crate::services::hid::TRACE_TOUCH_BASE.load(Ordering::Relaxed);
+    let len = crate::services::hid::TRACE_TOUCH_LEN.load(Ordering::Relaxed);
+    if base != 0 && address.wrapping_sub(base) < len {
+        unsafe { machine(ctx).memory.guard_cpu_reads(base, len); }
+    }
+}
+
+unsafe fn before_input_read(ctx: *mut Context, address: u32) {
+    use std::sync::{Mutex, OnceLock, atomic::Ordering};
+    let context = unsafe { &*ctx };
+    let (pc, r0, r1) = (context.r[15], context.r[0], context.r[1]);
+    unsafe { machine(ctx).memory.kiu_native_read(address, pc, r0, r1); }
+    let base = crate::services::hid::TRACE_TOUCH_BASE.load(Ordering::Relaxed);
+    if base == 0 || address.wrapping_sub(base) >= crate::services::hid::TRACE_TOUCH_LEN.load(Ordering::Relaxed) { return; }
+    static SEEN: OnceLock<Mutex<std::collections::BTreeSet<(u32,u32)>>> = OnceLock::new();
+    let context = unsafe { &*ctx };
+    if let Ok(mut seen) = SEEN.get_or_init(Default::default).lock() {
+        if seen.len() < 64 && seen.insert((context.r[15], context.r[14])) {
+            log::warn!("KIU touch reader: address={address:08X} context_pc={:08X} lr={:08X} sp={:08X} r0={:08X} r1={:08X} r2={:08X} r3={:08X}",
+                context.r[15],context.r[14],context.r[13],context.r[0],context.r[1],context.r[2],context.r[3]);
+        }
+    }
 }
 
