 /// instructions a run may take before it counts as stuck.
 const LIMIT: i32 = 200_000;
 
+// KIU evaluation: startup clears almost 2 MiB and exceeds the default budget.
+fn instruction_limit() -> i32 {
+    static VALUE: std::sync::OnceLock<i32> = std::sync::OnceLock::new();
+    *VALUE.get_or_init(|| std::env::var("KIU_VERIFY_LIMIT").ok()
+        .and_then(|value| value.parse::<i32>().ok())
+        .filter(|&value| value > 0 && value <= 10_000_000)
+        .unwrap_or(LIMIT))
+}
